generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum PixState {
  DRAFT
  AUTH_PENDING
  PROCESSING
  APPROVED
  REVIEW
  REJECTED
  FAILED
}

type RecipientSnapshot {
  recipientId    String
  name           String
  pixKeyMasked   String
  documentMasked String
  institution    String
}

// Registro dos grupos do workshop (DEV-004). O workspace padrão usado pelo
// modo solo/clone-fork (`DEFAULT_WORKSPACE_ID` em workspace-context.ts) não
// tem linha aqui — só grupos criados explicitamente pelo facilitador via
// `/api/v1/facilitator/workspaces`.
model Workspace {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @unique
  groupSlug   String   @unique
  codeHash    String
  createdAt   DateTime
}

model LocalProfile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String
  profileId   String
  displayName String
  account     Account?

  @@unique([workspaceId, profileId])
}

model Account {
  id                      String       @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId             String
  accountId               String
  profileId               String
  profile                 LocalProfile @relation(fields: [workspaceId, profileId], references: [workspaceId, profileId])
  ownerName               String
  documentMasked          String
  balanceCents            Int
  dailyLimitCents         Int
  transactionPasswordHash String
  knownDeviceIds          String[]

  @@unique([workspaceId, accountId])
  @@unique([workspaceId, profileId])
}

model Recipient {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String
  recipientId    String
  pixKeyHash     String
  pixKeyMasked   String
  name           String
  documentMasked String
  institution    String
  createdAt      DateTime

  @@unique([workspaceId, recipientId])
  @@index([workspaceId, pixKeyHash])
}

model PixIntent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String
  intentId    String
  requestId   String
  accountId   String
  recipientId String
  amountCents Int
  description String
  deviceId    String
  state       PixState @default(DRAFT)
  createdAt   DateTime
  expiresAt   DateTime

  @@unique([workspaceId, intentId])
  @@index([workspaceId, accountId, requestId])
}

model Transaction {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId       String
  transactionId     String
  requestId         String
  accountId         String
  recipientSnapshot RecipientSnapshot
  amountCents       Int
  description       String
  deviceId          String
  status            PixState
  riskScore         Int?
  reasonCodes       String[]
  createdAt         DateTime
  updatedAt         DateTime
  processedAt       DateTime?

  @@unique([workspaceId, transactionId])
  @@index([workspaceId, accountId, createdAt])
  @@index([workspaceId, requestId])
}
